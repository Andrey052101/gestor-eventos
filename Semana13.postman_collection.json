        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Prueba\",\n  \"descripcion\": \"Prueba\",\n  \"fecha\": \"2026-12-05\",\n  \"lugar\": \"Aula 1\",\n  \"categoria\": { \"id\": 999 }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/eventos",
