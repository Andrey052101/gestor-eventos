{
  "info": {
    "name": "Semana13 - API Eventos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "id", "value": "1" }
  ],
  "item": [
    {
      "name": "01 GET todos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/eventos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "eventos"]
        }
      },
      "response": []
    },
    {
      "name": "02 POST crear",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('id', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Feria de Tecnología\",\n  \"descripcion\": \"Exposición de proyectos de software\",\n  \"fecha\": \"2026-12-05\",\n  \"lugar\": \"Auditorio Central\",\n  \"categoria\": { \"id\": 1 }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/eventos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "eventos"]
        }
      },
      "response": []
    },
    {
      "name": "03 GET por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/eventos/{{id}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "eventos", "{{id}}"]
        }
      },
      "response": []
    },
    {
      "name": "04 PUT modificar",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Feria de Tecnología 2026\",\n  \"descripcion\": \"Exposición de proyectos de software y robótica\",\n  \"fecha\": \"2026-12-06\",\n  \"lugar\": \"Auditorio Central\",\n  \"categoria\": { \"id\": 1 }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/eventos/{{id}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "eventos", "{{id}}"]
        }
      },
      "response": []
    },
    {
      "name": "05 DELETE eliminar",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/eventos/{{id}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "eventos", "{{id}}"]
        }
      },
      "response": []
    },
    {
      "name": "06 GET 404 eliminado",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/eventos/{{id}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "eventos", "{{id}}"]
        }
      },
      "response": []
    },
    {
      "name": "07 POST error 400 campos vacios",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"nombre\": \"\", \"descripcion\": \"\", \"fecha\": \"\", \"lugar\": \"\" }",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/eventos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "eventos"]
        }
      },
      "response": []
